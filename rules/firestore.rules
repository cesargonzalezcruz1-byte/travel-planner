rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Editors: Cesar and Debora, signed in with their (verified) Google accounts
    function isEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['cesar.gonzalez.cruz1@gmail.com', 'deb777deb@gmail.com'];
    }
    // Family: the shared family login (password set in the Firebase console)
    function isFamily() {
      return request.auth != null && request.auth.token.email == 'family@travelplanner.app';
    }

    function validPost() {
      let d = request.resource.data;
      return ((isEditor() && d.by == 'editor') || (isFamily() && d.by == 'family'))
        && d.text is string && d.text.size() <= 4000 && d.date is string && d.author is string && d.author.size() <= 60
        && (!('rating' in d) || (d.rating is int && d.rating >= 0 && d.rating <= 5));
    }

    match /trips/{tripId} {
      allow read: if isEditor() || isFamily();
      allow write: if isEditor();

      // Itinerary the family can see: bookings (no confirmation numbers) and day activities/comments
      match /items/{id}   { allow read: if isEditor() || isFamily(); allow write: if isEditor(); }
      match /entries/{id} { allow read: if isEditor() || isFamily(); allow write: if isEditor(); }

      // Journal: everyone can read and post; the family can only change or delete family posts
      match /journal/{id} {
        allow read: if isEditor() || isFamily();
        allow create: if validPost();
        allow update: if isEditor() || (isFamily() && resource.data.by == 'family' && validPost());
        allow delete: if isEditor() || (isFamily() && resource.data.by == 'family');
      }

      // Editors only: confirmation numbers, costs, tickets, and the list of uploaded documents
      match /private/{id} { allow read, write: if isEditor(); }
      match /files/{id}   { allow read, write: if isEditor(); }
    }

    // Saved people and their travel documents (passports, visas...): editors only
    // Signed in with Google (or confirmed it's them) within the last 15 minutes
    function recentAuth() {
      return request.time < timestamp.value(request.auth.token.auth_time * 1000) + duration.value(15, 'm');
    }
    match /people/{id} {
      allow read, write: if isEditor();
      // Private part of a profile (birth date, contacts, health, document numbers): editors with a recent sign-in only
      match /vault/{doc} { allow read, write: if isEditor() && recentAuth(); }
    }

    // Everything else is locked
    match /{document=**} { allow read, write: if false; }
  }
}
