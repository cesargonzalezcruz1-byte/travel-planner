rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['cesar.gonzalez.cruz1@gmail.com', 'deb777deb@gmail.com'];
    }
    // Booking documents (PDFs, images): editors only, max 25 MB per file
    match /trips/{tripId}/files/{fileId}/{fileName} {
      allow read, delete: if isEditor();
      allow create, update: if isEditor() && request.resource.size < 25 * 1024 * 1024;
    }
    function recentAuth() {
      return request.time < timestamp.value(request.auth.token.auth_time * 1000) + duration.value(15, 'm');
    }
    // Passport / visa scans: editors who signed in (or confirmed it's them) in the last 15 minutes, max 25 MB per file
    match /people/{personId}/{fileId}/{fileName} {
      allow read, create, update: if isEditor() && recentAuth() && (request.resource == null || request.resource.size < 25 * 1024 * 1024);
      allow delete: if isEditor();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
