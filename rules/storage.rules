rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['cesar.gonzalez.cruz1@gmail.com', 'deb777deb@gmail.com'];
    }
    // Booking documents (PDFs, images): editors only, max 25 MB per file
    match /trips/{tripId}/files/{fileId}/{fileName} {
      allow read, delete: if isEditor();
      allow create, update: if isEditor() && request.resource.size < 25 * 1024 * 1024;
    }
    // Travel documents of saved people (passport, visa scans): editors only, max 25 MB per file
    match /people/{personId}/{fileId}/{fileName} {
      allow read, delete: if isEditor();
      allow create, update: if isEditor() && request.resource.size < 25 * 1024 * 1024;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
